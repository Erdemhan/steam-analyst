# Copy this file to .env and adjust as needed for local development.
# Every variable is optional; defaults are shown below. See
# src/steam_analyst/config/settings.py (load_settings) for full details.

# Steam Web API key. Not required by the endpoints this project currently
# calls (appdetails, reviews, SteamSpy are all public/unauthenticated), but
# supported if a future data source needs one.
STEAM_WEB_API_KEY=

# STEAM_ANALYST_DB_PATH=data/analyses.db
# STEAM_ANALYST_PARAMETERS_PATH=config/parameters.toml
# STEAM_ANALYST_HTTP_TIMEOUT_SECONDS=30
# STEAM_ANALYST_USER_AGENT=Steam-Analyst/1.0 (research; +https://github.com/...)
